<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".RoomButtonWidgetReceiver"
            android:exported="true"
            android:label="@string/june_widget_room_button_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/june_room_button_widget_info" />
        </receiver>

        <receiver
            android:name=".RoomListWidgetReceiver"
            android:exported="true"
            android:label="@string/june_widget_room_list_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/june_room_list_widget_info" />
        </receiver>

        <activity
            android:name=".config.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/june_widget_config_title"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".config.JuneSettingsActivity"
            android:exported="false"
            android:label="June 꾸미기"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Element June: "봇 선택" launcher icon, bot rooms fan out from it -->
        <activity
            android:name=".picker.BotPickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:icon="@drawable/june_bot_picker_icon"
            android:roundIcon="@drawable/june_bot_picker_icon"
            android:label="@string/june_bot_picker_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".picker.BotPickerConfigActivity"
            android:exported="false"
            android:label="봇 선택 아이콘"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
          Element June: "커맨더 음성" launcher icon. Tapping it starts the recording without any app screen,
          tapping it again sends the recording to the commander room. Same shape as the bot picker icon above.
        -->
        <activity
            android:name=".voice.JuneVoiceShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:icon="@drawable/june_voice_shortcut_icon"
            android:roundIcon="@drawable/june_voice_shortcut_icon"
            android:label="@string/june_voice_shortcut_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Records and sends while no screen of the app is shown; the microphone permissions already exist in the app -->
        <service
            android:name=".voice.JuneVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
